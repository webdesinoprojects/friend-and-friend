generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id              String             @id @default(cuid())
  fullName        String
  email           String?            @unique
  phone           String             @unique
  passwordHash    String?
  dob             String?
  gender          String?
  city            String?
  state           String?
  role            UserRole
  mobileVerified  Boolean            @default(false)
  emailVerified   Boolean            @default(false)
  kycStatus       VerificationStatus @default(PENDING)
  faceStatus      VerificationStatus @default(PENDING)
  referenceSelfie String?
  profileImage    String?
  isBlocked       Boolean            @default(false)
  blockReason     String?
  disabledAt      DateTime?
  disabledUntil   DateTime?
  aadhaarLast4    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpTokens       OtpToken[]
  kycVerification KycVerification?
  userProfile     UserProfile?
  providerProfile ProviderProfile?
  loginAttempts   LoginAttempt[]
  bookings         Booking[]      @relation("BookingUser")
  providerBookings Booking[]      @relation("BookingProviderUser")
  sentMessages     ChatMessage[]  @relation("MessageSender")
  reviewReports    ReviewReport[]

  @@index([disabledUntil])
}

model RegistrationApplication {
  id               String             @id @default(cuid())
  fullName         String
  email            String             @unique
  phone            String             @unique
  passwordHash     String
  dob              String?
  gender           String?
  city             String?
  state            String?
  role              UserRole
  mobileVerified   Boolean            @default(false)
  emailVerified    Boolean            @default(false)
  profileImage     String?
  referenceSelfie  String?
  documentType     String
  documentNumber   String
  documentLast4    String?
  documentUrl      String
  consentAccepted  Boolean            @default(false)
  userProfile      Json?
  providerProfile  Json?
  status           VerificationStatus @default(PENDING)
  rejectionReason  String?
  decisionAt       DateTime?
  approvedUserId   String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
}

model AccountDeletionAudit {
  id             String   @id @default(cuid())
  originalUserId String   @unique
  role           UserRole
  deletedAt      DateTime @default(now())

  @@index([role, deletedAt])
}

model OtpToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  phone     String?
  otp       String
  type      String
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycVerification {
  id                  String             @id @default(cuid())
  userId              String             @unique
  aadhaarLast4        String?
  documentType        String?
  documentNumber      String?
  documentNumberLast4 String?
  documentUrl         String?
  consentAccepted     Boolean            @default(false)
  status              VerificationStatus @default(PENDING)
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id                  String  @id @default(cuid())
  userId              String  @unique
  interests           String?
  preferredActivities String?
  activityPreferences String?
  preferredLanguage   String?
  bio                 String?
  profileQuestions    Json?
  emergencyContact    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProviderProfile {
  id     String @id @default(cuid())
  userId String @unique

  headline   String?
  profession String?
  education  String?
  height     String?
  hobbies    String?

  hourlyPrice      String?
  availableCity    String?
  languages        String?
  availabilityDays String?
  availabilitySlots Json?
  activities       String?
  bio              String?
  profileImages    Json?
  profileQuestions Json?

  providerSafetyAgreement Boolean @default(false)
  approved                Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model LoginAttempt {
  id          String  @id @default(cuid())
  userId      String?
  email       String?
  success     Boolean @default(false)
  faceMatched Boolean @default(false)
  message     String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Booking {
  id             String   @id @default(cuid())
  code           String   @unique
  userId         String
  providerId     String
  providerUserId String
  service        String
  date           String
  time           String
  durationHours  Int      @default(1)
  amount         Int      @default(0)
  paymentMethod  String?
  paymentStatus  String   @default("PAID")
  status         String   @default("CONFIRMED")
  cancelReason   String?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerUser User            @relation("BookingProviderUser", fields: [providerUserId], references: [id], onDelete: Cascade)
  chatThread   ChatThread?
}

model ChatThread {
  id        String   @id @default(cuid())
  bookingId String   @unique
  userId    String
  providerId String
  providerUserId String
  closed    Boolean  @default(false)
  closedReason String?
  hiddenForUser Boolean @default(false)
  hiddenForProvider Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([providerUserId])
  @@index([userId, providerId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String?
  senderRole String
  type      String   @default("TEXT")
  text      String?
  mediaUrl  String?
  mediaFileId String?
  durationSeconds Int?
  system    Boolean  @default(false)
  readAt    DateTime?
  editedAt  DateTime?
  deletedAt DateTime?

  createdAt DateTime @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User?      @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
}

model ReviewReport {
  id             String   @id @default(cuid())
  reviewId       String?
  bookingId      String?
  reporterId     String
  reporterRole   String
  reporterName   String?
  reportedUserId String?
  reportedName   String?
  targetRole     String?
  rating         Int?
  reviewText     String?
  reason         String
  status         String   @default("OPEN")
  adminAction    String?
  adminNote      String?
  reviewSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([reporterId])
}

model SiteContent {
  id        String   @id
  content   Json
  updatedAt DateTime @updatedAt
}

model KycReviewHistory {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  status    String
  reason    String?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
